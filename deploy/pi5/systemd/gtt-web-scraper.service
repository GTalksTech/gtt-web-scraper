# Starts gtt-web-scraper at boot, once Docker and Tailscale are up.
# Installed by install.sh, which replaces @DIR@ with the deploy dir.
[Unit]
Description=gtt-web-scraper (tailnet only)
Requires=docker.service
Wants=network-online.target tailscaled.service
After=network-online.target docker.service tailscaled.service
# Keep retrying: right after boot the Tailscale IP may not be on tailscale0 yet.
StartLimitIntervalSec=0

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=@DIR@
ExecStart=/usr/bin/flock /run/lock/gtt-web-scraper.lock @DIR@/gtt-up.sh
Restart=on-failure
RestartSec=30s
# compose.yml refuses to parse without TAILNET_IP; down doesn't need the real one.
ExecStop=/usr/bin/env TAILNET_IP=127.0.0.1 /usr/bin/docker compose down
TimeoutStartSec=45min

[Install]
WantedBy=multi-user.target
