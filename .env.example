# gtt-web-scraper runtime settings. Placeholders only: never commit a real value.
#
# The real file lives only on the host (pi5), untracked, mode 0600.
# scripts/setup/wizard.sh fills it in and checks each key works.

# Paid Fetcher (Firecrawl): the last Fetcher on the Ladder. Never used for search.
FIRECRAWL_API_KEY=fc-replace-me

# Search Providers, tried in this order.
TINYFISH_API_KEY=replace-me
EXA_API_KEY=replace-me
TAVILY_API_KEY=tvly-replace-me

# Lets the host send Incidents to GitHub as repository dispatch events.
# Fine-grained token, this repo only, Contents: read and write (the narrowest
# permission GitHub accepts for dispatch events).
GITHUB_DISPATCH_TOKEN=github_pat_replace-me
